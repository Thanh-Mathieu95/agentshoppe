# Để trống OPENAI_API_KEY -> agent chạy chế độ luật (offline), demo vẫn chạy đủ.
OPENAI_API_KEY=
# OPENAI_BASE_URL=          # endpoint tương thích OpenAI (tùy chọn)
LLM_MODEL=                  # mô hình có tool calling + vision
# AGENT_MODE=llm            # llm | rules (mặc định: llm nếu có key + model)
STT_PROVIDER=browser        # browser (Web Speech vi-VN) | openai
TTS_PROVIDER=browser        # browser (speechSynthesis) | openai
CONFIRM_TIMEOUT_S=30
PENDING_PUBLISH_MIN=10
RUBBER_STAMP_MS=2000
ASR_CONF_THRESHOLD=0.85
